---
import { readFileSync } from 'node:fs';
import Wordmark from '../components/Wordmark.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

// The data-currency stamp, read from the pipeline outputs at build time.
const processedDir = new URL('../../../data/processed/', import.meta.url);
const manifest = JSON.parse(
  readFileSync(new URL('manifest.json', processedDir), 'utf-8'),
);
const custody = JSON.parse(
  readFileSync(new URL('custody_monthly.json', processedDir), 'utf-8'),
);
const latestMonth = custody.meta.latest_month;
const latestProvisional = custody.records.some(
  (r: { month: string; provisional: boolean }) =>
    r.month === latestMonth && r.provisional,
);
const dataAsOf =
  new Date(`${latestMonth}-01`).toLocaleString('en-GB', {
    month: 'long',
    year: 'numeric',
  }) + (latestProvisional ? ' (provisional)' : '');
const builtOn = new Date(manifest.meta.build_timestamp).toLocaleDateString(
  'en-GB',
  { day: 'numeric', month: 'long', year: 'numeric' },
);

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/national', label: 'National picture' },
  { href: '/methods', label: 'Methods' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,500;0,700;1,500&family=IBM+Plex+Mono&family=Inter:wght@400;500;600&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* PRISM-R wordmark. EB Garamond, with the I and R italicised as
         family-identity accent letters. Display mode carries the two slate
         accents; navigation mode is a quiet single tone. */
      .wordmark {
        font-family: 'EB Garamond', Georgia, serif;
        font-weight: 700;
        color: #161512;
        letter-spacing: -0.01em;
        white-space: nowrap;
      }
      .wordmark-i {
        font-style: italic;
        font-weight: 500;
        color: #1b3a5f;
      }
      .wordmark-r {
        font-style: italic;
        font-weight: 500;
        color: #4a6b8c;
      }
      .wordmark--nav {
        color: #3f5570;
      }
      .wordmark--nav .wordmark-i,
      .wordmark--nav .wordmark-r {
        color: inherit;
      }
      /* Landing-hero strap-line, mirroring the parent PRISM strap. */
      .strapline {
        font-family: 'IBM Plex Mono', ui-monospace, 'Menlo', monospace;
        font-size: 0.78rem;
        letter-spacing: 0.05em;
        color: #8a8782;
      }
      /* Page titles across the site: the display serif, echoing the
         wordmark, rather than interface sans. */
      .page-title {
        font-family: 'EB Garamond', Georgia, serif;
        font-weight: 700;
        font-size: 2rem;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: #161512;
      }
      /* Quiet identity details. */
      ::selection {
        background: #1b3a5f;
        color: #ffffff;
      }
      a:focus-visible {
        outline: 2px solid #4a6b8c;
        outline-offset: 2px;
        border-radius: 1px;
      }
      /* One restrained staggered reveal on page load. */
      @media (prefers-reduced-motion: no-preference) {
        .reveal {
          opacity: 0;
          transform: translateY(6px);
          animation: reveal 0.55s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
        }
        .reveal-2 { animation-delay: 0.08s; }
        .reveal-3 { animation-delay: 0.16s; }
        @keyframes reveal {
          to { opacity: 1; transform: none; }
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-white font-serif text-ink antialiased">
    <header class="border-b border-neutral-200">
      <nav
        class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4 font-sans text-sm"
      >
        <a href="/" class="text-base"><Wordmark nav /></a>
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            navLinks.map((link) => {
              const linkPath = link.href.replace(/\/$/, '') || '/';
              const isActive = currentPath === linkPath;
              return (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      'pb-1 transition-colors hover:text-accent',
                      isActive
                        ? 'border-b border-accent text-accent'
                        : 'text-neutral-600',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-12">
      <slot />
    </main>

    <footer class="mt-16 border-t border-neutral-200">
      <div
        class="mx-auto flex max-w-3xl flex-col gap-1.5 px-6 py-8 font-sans text-xs text-neutral-500"
      >
        <p class="strapline" style="font-size: 0.66rem;">
          Prevention Risk Intelligence &amp; Stratified Mapping: Remand
        </p>
        <p><Wordmark nav />, Oxon Advisory. Hosted on Prevention Works.</p>
        <p>Data as of {dataAsOf}, built {builtOn}.</p>
        <p>
          <a
            href="https://github.com/SGilr/prism-r"
            class="underline underline-offset-2 hover:text-accent"
          >
            GitHub repository
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
