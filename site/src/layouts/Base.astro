---
interface Props {
  title: string;
}

const { title } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/national', label: 'National picture' },
  { href: '/methods', label: 'Methods' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opt@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-white font-serif text-ink antialiased">
    <header class="border-b border-neutral-200">
      <nav
        class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4 font-sans text-sm"
      >
        <a href="/" class="font-semibold tracking-tight text-ink">PRISM-R</a>
        <ul class="flex gap-6">
          {
            navLinks.map((link) => {
              const linkPath = link.href.replace(/\/$/, '') || '/';
              const isActive = currentPath === linkPath;
              return (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      'transition-colors hover:text-accent',
                      isActive ? 'text-accent' : 'text-neutral-600',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-12">
      <slot />
    </main>

    <footer class="mt-16 border-t border-neutral-200">
      <div
        class="mx-auto flex max-w-3xl flex-col gap-1 px-6 py-8 font-sans text-xs text-neutral-500"
      >
        <p>PRISM-R, Oxon Advisory. Hosted on Prevention Works.</p>
        <p>
          <a
            href="https://github.com/SGilr/prism-r"
            class="underline underline-offset-2 hover:text-accent"
          >
            GitHub repository
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
