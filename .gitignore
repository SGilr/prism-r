# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Pipeline working files
data/interim/*
!data/interim/.gitkeep

# Build log: a runtime artefact written by pipeline/build.py. The committed
# provenance record is data/processed/manifest.json, not this log.
data/processed/build.log

# Raw source downloads, not committed; reproducible from the documented sources.
data/raw/*
!data/raw/.gitkeep
# The fetch manifest is tracked: the machine-readable retrieval log.
!data/raw/fetch_manifest.json
# The ONS filter manifest is tracked, so the Census downloads are reproducible
# by anyone with a copy of it; the bulk CSVs themselves stay untracked.
!data/raw/ons-census-2021/
data/raw/ons-census-2021/*
!data/raw/ons-census-2021/filter_manifest.json

# Cloudflare Wrangler local cache
.wrangler/

# OS
.DS_Store

# Editor
.vscode/
.idea/
